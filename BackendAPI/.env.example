# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=3001
APP_ENV=development

# Database Configuration
# DATABASE_URL will be provided by the deployment agent
# Example: postgresql://user:password@localhost:5432/uppuveli_beach
DATABASE_URL=

# JWT Configuration
# IMPORTANT: Generate a secure random secret for production
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRES_MIN=60

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost,ionic://localhost

# Admin OAuth2 Mock Clients Configuration
# JSON array of OAuth client configurations for admin panel
# Each client needs: provider, client_id, client_secret
# Example for multiple providers:
ADMIN_OAUTH_CLIENTS=[{"provider":"google","client_id":"mock-google-client","client_secret":"mock-google-secret"},{"provider":"azuread","client_id":"mock-azure-client","client_secret":"mock-azure-secret"}]

# Payment Gateway Configuration (optional)
# STRIPE_KEY=sk_test_...
# PAYPAL_KEY=...

# Firebase Cloud Messaging (optional)
# FCM_KEY=...

# Database Table Creation (optional)
# Set to true to auto-create tables on startup
# CREATE_TABLES=true
