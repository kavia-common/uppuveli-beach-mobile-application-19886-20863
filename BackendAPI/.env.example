# BackendAPI environment example

# App
APP_HOST=0.0.0.0
APP_PORT=3001
APP_ENV=development

# Security
JWT_SECRET=change-me-in-dev
JWT_EXPIRES_MIN=60

# Database
# Example: postgresql://user:pass@localhost:5432/uppuveli
DATABASE_URL=

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost,ionic://localhost

# Admin OAuth clients (JSON array)
# Example: [{"provider":"mock","client_id":"admin-web","client_secret":"dev-secret"}]
ADMIN_OAUTH_CLIENTS=[]

# Payment providers (optional for stubs)
STRIPE_KEY=
PAYPAL_KEY=

# Notifications (optional for stubs)
FCM_KEY=
