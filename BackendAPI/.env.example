# BackendAPI example environment variables

APP_HOST=0.0.0.0
APP_PORT=3001
APP_ENV=development

# PostgreSQL connection URL
DATABASE_URL=postgresql://user:password@localhost:5432/uppuveli

# JWT settings
JWT_SECRET=change-me
JWT_EXPIRES_MIN=60

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost,ionic://localhost

# Admin OAuth clients for WebAdminPanel (JSON array)
# Example: [{"provider":"mock","client_id":"admin-web","client_secret":"dev-secret"}]
ADMIN_OAUTH_CLIENTS=[]

# Payment provider keys (optional; stubbed if missing)
STRIPE_KEY=
PAYPAL_KEY=

# Firebase Cloud Messaging (optional for notifications)
FCM_KEY=
