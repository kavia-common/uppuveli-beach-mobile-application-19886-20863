# BackendAPI environment variables

# JWT settings
JWT_SECRET=dev-insecure-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (SQLite default path)
DATABASE_URL=sqlite:///./app.db

# Seed demo data on startup (demo user and booking)
SEED_DEMO=true

# Payments
# No external gateway keys are required: payments are simulated deterministically for tests and local dev.
