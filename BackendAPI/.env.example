# Copy to .env and adjust values for your environment

# JWT configuration
JWT_SECRET=change-me-dev-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (SQLite default)
DATABASE_URL=sqlite:///./app.db

# Seed demo data on startup (true/false)
SEED_DEMO=true

# Server port used by preview (do not change unless needed)
PORT=3001
