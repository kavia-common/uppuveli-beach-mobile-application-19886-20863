# Application configuration
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/uppuveli_db

# Auth/JWT
JWT_SECRET=please_change_me_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OAuth (if applicable for social login or admin panel)
OAUTH_CLIENT_ID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret

# Payments
STRIPE_API_KEY=your_stripe_api_key
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# Push notifications
FCM_SERVER_KEY=your_fcm_server_key

# Seed helpers (optional)
SEED_ADMIN_EMAIL=admin@uppuvelibeach.com
SEED_ADMIN_PASSWORD=change_me_admin
