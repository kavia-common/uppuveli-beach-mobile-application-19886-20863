# BackendAPI Environment Configuration
# Copy this file to ".env" and fill in the values. Do NOT commit real secrets.

# Server
APP_HOST=0.0.0.0
APP_PORT=3001
APP_ENV=development

# Database
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_MIN=60

# CORS
# Comma-separated list of allowed origins for CORS.
# Example: http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost,ionic://localhost
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost,ionic://localhost

# Admin OAuth (JSON array of client definitions; keep as a single line)
# Example: [{"provider":"google","client_id":"...","client_secret":"..."}]
ADMIN_OAUTH_CLIENTS=[]

# Payments
STRIPE_KEY=your_stripe_secret_key
PAYPAL_KEY=your_paypal_client_secret

# Push Notifications
FCM_KEY=your_firebase_cloud_messaging_server_key
