# Copy to .env and update values

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/uppuveli_db

# JWT
JWT_SECRET=change_me_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OAuth client (optional)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Payments (optional for stubs)
STRIPE_API_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# FCM (optional for notification stubs)
FCM_SERVER_KEY=

# Seed admin (optional)
SEED_ADMIN_EMAIL=admin@uppuvelibeach.com
SEED_ADMIN_PASSWORD=change_me_admin
