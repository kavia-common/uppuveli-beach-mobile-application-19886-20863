# Backend API Environment Configuration
# Copy this file to .env and set appropriate values for your environment

# ============================================================
# Application Settings
# ============================================================

# Host interface to bind (default: 0.0.0.0 for all interfaces)
APP_HOST=0.0.0.0

# Port to listen on (default: 3001)
APP_PORT=3001

# Environment name: development, staging, production
APP_ENV=development

# ============================================================
# Database Configuration
# ============================================================

# PostgreSQL connection URL
# Format: postgresql://user:password@host:port/database
# Example: postgresql://hotel_user:password@localhost:5432/uppuveli_beach
# Note: DATABASE_URL must be set for database-dependent endpoints to work
DATABASE_URL=

# ============================================================
# JWT Authentication
# ============================================================

# Secret key for signing JWT tokens
# IMPORTANT: Generate a strong random secret for production
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# JWT token expiration time in minutes (default: 60)
JWT_EXPIRES_MIN=60

# ============================================================
# CORS Configuration
# ============================================================

# Comma-separated list of allowed CORS origins
# Default includes localhost:3000 (web admin), capacitor://localhost, ionic://localhost (mobile)
# Example: http://localhost:3000,https://admin.uppuvelibeach.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost,ionic://localhost

# ============================================================
# Admin OAuth2 Configuration
# ============================================================

# JSON array of OAuth client configurations for Web Admin Panel
# Each client should have: provider, client_id, client_secret
# Example: [{"provider":"google","client_id":"your-client-id","client_secret":"your-secret"},{"provider":"azuread","client_id":"your-client-id","client_secret":"your-secret"}]
# For local development mock:
ADMIN_OAUTH_CLIENTS=[{"provider":"mock","client_id":"admin-web","client_secret":"dev-secret"}]

# ============================================================
# Payment Provider Keys
# ============================================================

# Stripe API secret key (optional for stub mode)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_KEY=

# PayPal client secret (optional for stub mode)
# Get from: https://developer.paypal.com/dashboard/applications
PAYPAL_KEY=

# ============================================================
# Notification Services
# ============================================================

# Firebase Cloud Messaging server key (optional for stub mode)
# Get from: Firebase Console > Project Settings > Cloud Messaging
FCM_KEY=

# ============================================================
# Notes
# ============================================================
# 1. Never commit .env file to version control
# 2. Keep production secrets secure and rotate regularly
# 3. Use strong, randomly generated values for JWT_SECRET in production
# 4. DATABASE_URL is required for all database operations
# 5. CORS_ORIGINS should be configured for your deployed frontend URLs
# 6. ADMIN_OAUTH_CLIENTS should use real OAuth providers in production
