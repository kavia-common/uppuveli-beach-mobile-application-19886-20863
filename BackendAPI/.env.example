# BackendAPI environment variables

# Application
APP_HOST=0.0.0.0
APP_PORT=3001
APP_ENV=development

# Database
# Example: postgresql://user:password@localhost:5432/uppuveli
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Auth / Security
JWT_SECRET=changeme-in-dev
JWT_EXPIRES_MIN=60

# CORS (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost,ionic://localhost

# Admin OAuth clients (JSON array)
# ADMIN_OAUTH_CLIENTS=[{"provider":"google","client_id":"id","client_secret":"secret"}]

# Payments (optional)
# STRIPE_KEY=
# PAYPAL_KEY=

# Firebase (optional)
# FCM_KEY=
