# Server
APP_HOST=0.0.0.0
APP_PORT=3001
APP_ENV=development

# Security
JWT_SECRET=change-me
JWT_EXPIRES_MIN=60

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/uppuveli

# CORS
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost,ionic://localhost

# Admin OAuth clients (JSON array)
# Example:
# ADMIN_OAUTH_CLIENTS='[{"provider":"mock","client_id":"admin-web","client_secret":"dev-secret"}]'
ADMIN_OAUTH_CLIENTS=[]

# Integrations (optional)
STRIPE_KEY=
PAYPAL_KEY=
FCM_KEY=
